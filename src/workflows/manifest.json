          {
            "id": "detailed",
            "label": "Describe (detailed)",
            "preset": "🖼️ Detailed Description"
          },
          {
            "id": "simple",
            "label": "Describe (short)",
            "preset": "🖼️ Simple Description"
          },
          {
            "id": "tags",
            "label": "Tags",
            "preset": "🖼️ Tags"
          },
          {
            "id": "prompt",
            "label": "Reverse prompt",
            "preset": "🪄 Prompt Refine & Expand"
          },
          {
            "id": "cinematic",
            "label": "Cinematic",
            "preset": "🎬 Cinematic Description"
          },
          {
            "id": "analysis",
            "label": "Analysis",
            "preset": "🖼️ Detailed Analysis"
          },
          {
            "id": "ocr",
            "label": "Extract text (OCR)",
            "instruction": "Read and transcribe every piece of text visible in this image exactly, preserving line breaks and reading order. Output only the extracted text with no commentary. If there is no text, reply 'No text found.'"
          },
          {
            "id": "product",
            "label": "Product copy",
            "instruction": "You are an e-commerce copywriter. Based only on what is visible, write a product listing: a one-line title, a 2-3 sentence description, 4-6 bullet-point features, and 8-12 relevant hashtags. Use plain text with simple labels, no markdown."
          },
          {
            "id": "critique",
            "label": "Critique",
            "instruction": "Act as an art director reviewing this image. Give concise, constructive feedback: what works, what weakens it (composition, lighting, color, subject, artifacts), and 3-5 specific, actionable suggestions to improve it. No preamble."
          },
          {
            "id": "json",
            "label": "Tags (JSON)",
            "instruction": "Analyze the image and output a compact JSON object with keys: subject, objects (array), setting, colors (array), lighting, mood, style, and tags (array of up to 20 short strings). Output only valid JSON with no markdown fences or commentary."
          },
          {
            "id": "moderation",
            "label": "Safety moderation",
            "instruction": "You are a strict image safety moderator for an SFW image product. Classify the image into exactly one outcome:\n- safe-output: no nudity, no sexual acts, no explicit genitalia; may be mildly suggestive clothing only if not sexualized\n- fail-suggestive: soft NSFW, lingerie/underwear focus, sexual posing, heavy cleavage/bulge emphasis, or erotic atmosphere without clear genitalia/sex acts\n- fail-explicit: clear nudity with genitalia, sexual intercourse/acts, or pornographic intent\nRespond with ONLY valid JSON (no markdown fences): {\"outcome\":\"safe-output\"|\"fail-suggestive\"|\"fail-explicit\",\"confidence\":0.0-1.0,\"rationale\":\"one short sentence\"}"
          }
        ],
        "historyTimeoutMs": 300000
      }
