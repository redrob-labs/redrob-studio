# ComfyUI API base URL (server-only, no trailing slash).
# Never expose this to the browser - the app proxies via /api/comfy.
COMFYUI_URL=http://127.0.0.1:8188

# Optional (GPU host only): Hugging Face token for scripts/setup-comfyui-local.sh
# when a download requires auth. Do not put secrets in the Next.js app env.
# HF_TOKEN=
